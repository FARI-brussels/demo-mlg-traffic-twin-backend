# Caddyfile for Traffic Twin - Frontend + Backend
# This file configures Caddy to serve both frontend and backend on the same domain

# For production with a domain name, uncomment and configure:
# your-domain.com {
#     # Define backend proxy settings once
#     @backend {
#         path /simulate /get_current_deviations /generate_network_from_bounding_box /generate_network_geojson /docs /openapi.json /redoc
#     }
#     
#     # API routes - proxy to backend
#     handle @backend {
#         reverse_proxy backend:8000 {
#             header_up Host {host}
#             header_up X-Real-IP {remote}
#             header_up X-Forwarded-For {remote}
#             header_up X-Forwarded-Proto {scheme}
#         }
#     }
#     
#     # Frontend static files - serve everything else
#     handle {
#         root * /var/www/frontend/dist
#         try_files {path} /index.html
#         file_server
#     }
#     
#     # Enable compression
#     encode gzip
#     
#     # Logging
#     log {
#         output file /var/log/caddy/access.log
#     }
# }

# For local development/testing without SSL:
localhost {
    # Define backend proxy settings once
    @backend {
        path /simulate /get_current_deviations /generate_network_from_bounding_box /generate_network_geojson /docs /openapi.json /redoc
    }
    
    # API routes - proxy to backend
    handle @backend {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    # Frontend dev server - proxy to Vite dev server
    handle {
        reverse_proxy host.docker.internal:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    # Enable compression
    encode gzip
}




